@model List<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Customers</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Customer</a>
</div>
<div class="card p-3">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6"><input name="q" value="@ViewData["q"]" class="form-control" placeholder="Search name, email, phone or company..." /></div>
        <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search"></i> Search</button> <a asp-action="Index" class="btn btn-light">Reset</a></div>
    </form>
    <div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>City</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td class="fw-semibold">@c.Name</td><td>@c.Email</td><td>@c.Phone</td><td>@c.Company</td><td>@c.City</td>
                <td><span class="badge bg-@Options.Badge(c.Status)">@c.Status</span></td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this customer?');">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No customers found.</td></tr> }
        </tbody>
    </table>
    </div>
</div>
