@model List<FollowUp>
@{ ViewData["Title"] = "Follow-Ups"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Follow-Ups</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Schedule Follow-Up</a>
</div>
<div class="card p-3">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5"><input name="q" value="@ViewData["q"]" class="form-control" placeholder="Search subject, customer or lead..." /></div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in Options.FollowUpStatuses) { <option value="@s" selected="@((string?)ViewData["status"] == s)">@s</option> }
            </select>
        </div>
        <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search"></i> Search</button> <a asp-action="Index" class="btn btn-light">Reset</a></div>
    </form>
    <div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Date</th><th>Subject</th><th>Related To</th><th>Type</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var f in Model)
        {
            bool overdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
            <tr>
                <td>@f.FollowUpDate.ToString("dd MMM yyyy")@if (overdue) { <span class="badge bg-danger ms-1">Overdue</span> }</td>
                <td class="fw-semibold">@f.Subject</td>
                <td>@(f.Customer?.Name ?? f.Lead?.Name)</td>
                <td>@f.Type</td>
                <td><span class="badge bg-@Options.Badge(f.Status)">@f.Status</span></td>
                <td class="text-end">
                    @if (f.Status == "Planned")
                    {
                        <form asp-action="Complete" asp-route-id="@f.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-success" title="Mark completed"><i class="bi bi-check2"></i></button>
                        </form>
                    }
                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up?');">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No follow-ups found.</td></tr> }
        </tbody>
    </table>
    </div>
</div>
