@model FollowUp
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" class="form-control" /><span asp-validation-for="FollowUpDate" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="(SelectList)ViewBag.Customers" class="form-select"><option value="">-- None --</option></select></div>
    <div class="col-md-6"><label asp-for="LeadId" class="form-label"></label>
        <select asp-for="LeadId" asp-items="(SelectList)ViewBag.Leads" class="form-select"><option value="">-- None --</option></select></div>
    <div class="col-md-6"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="@(new SelectList(Options.FollowUpTypes))" class="form-select"></select></div>
    <div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="@(new SelectList(Options.FollowUpStatuses))" class="form-select"></select></div>
    <div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea><span asp-validation-for="Remarks" class="text-danger"></span></div>
</div>
<div class="mt-4"><button class="btn btn-primary"><i class="bi bi-save"></i> Save</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div>
