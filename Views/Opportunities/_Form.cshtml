@model Opportunity
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="CreatedDate" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="(SelectList)ViewBag.Customers" class="form-select"><option value="">-- Select customer --</option></select>
        <span asp-validation-for="CustomerId" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" /><span asp-validation-for="Amount" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" /><span asp-validation-for="Probability" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="@(new SelectList(Options.Stages))" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
</div>
<div class="mt-4"><button class="btn btn-primary"><i class="bi bi-save"></i> Save</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div>
