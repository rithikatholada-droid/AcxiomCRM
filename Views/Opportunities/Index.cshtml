@model List<Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Opportunities</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Opportunity</a>
</div>
<div class="card p-3">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5"><input name="q" value="@ViewData["q"]" class="form-control" placeholder="Search opportunity or customer..." /></div>
        <div class="col-md-3">
            <select name="stage" class="form-select">
                <option value="">All stages</option>
                @foreach (var s in Options.Stages) { <option value="@s" selected="@((string?)ViewData["stage"] == s)">@s</option> }
            </select>
        </div>
        <div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search"></i> Search</button> <a asp-action="Index" class="btn btn-light">Reset</a></div>
    </form>
    <div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Opportunity</th><th>Customer</th><th>Amount</th><th>Prob.</th><th>Weighted</th><th>Close Date</th><th>Stage</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td class="fw-semibold">@o.Name</td><td>@o.Customer?.Name</td>
                <td>₹@o.Amount.ToString("N0")</td>
                <td>
                    <div class="progress" style="height:8px;width:70px"><div class="progress-bar" style="width:@o.Probability%"></div></div>
                    <small>@o.Probability%</small>
                </td>
                <td>₹@o.WeightedValue.ToString("N0")</td>
                <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                <td><span class="badge bg-@Options.Badge(o.Stage)">@o.Stage</span></td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@o.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this opportunity?');">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No opportunities found.</td></tr> }
        </tbody>
    </table>
    </div>
</div>
